          cout<<"D\nSUPPLEMENTARY ";
       
      }
   
   return 0;
}

//program 3
//odd even 
#include <iostream>
using namespace std;
int main(){
   int n;
   cout<<"Enter your number:";
   cin>>n;
   cout<<"\nYour result....\n";
   
   if(n%2==0){
      cout<<n<<" "<<"Is Even Number";
       
   }
   else if(n%2!=0){
       cout<<n<<" "<<"Is Odd Number";
   } 
      
      else{
          cout<<"Wrong Input";
       
      }
   
   return 0;
}
                  
