//IF-ELSE STATEMENTS
//Program-1 
//compare number 
#include <iostream>
using namespace std;
int main(){
   int n;
   cout<<"Enter your number:";
   cin>>n;
   cout<<"\nYour result....\n\n";
   
   if(n>=50){
       cout<<n<<" "<<"Number is greater  ";
       
   }
   else{
       cout<<n<<" "<<"Number is smaller";
   }
   return 0;
}

