   int n;
   cout<<"Enter your marks:";
   cin>>n;
   cout<<"\nYour result....\n";
   
   if(n>=80){
       cout<<"A+\nPromoted by Good Grades";
       
   }
   else if(n>=70){
       cout<<"B\npromoted ";
   } 
      else if(n>=50) {
          cout<<"C\npromoted By Grace Marks";
       
